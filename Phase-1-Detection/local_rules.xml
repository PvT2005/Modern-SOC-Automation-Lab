
<group name="local,mitre_attack,soc_lab,">
  <rule id="100001" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^10$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe</field>
    <description>Sysmon EID 10: Process accessed LSASS — possible credential dump [T1003.001]</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_dumping,high_severity</group>
  </rule>

  <rule id="100002" level="14">
    <if_sid>100001</if_sid>
    <field name="win.eventdata.grantedAccess" type="pcre2">0x(1[04][01]0|1FFFFF|0800|0810|001010)</field>
    <description>CRITICAL: LSASS memory dump — suspicious GrantedAccess mask detected [T1003.001]</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_dumping,critical</group>
  </rule>

  <rule id="100010" level="5">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell(\.exe)?$</field>
    <description>Sysmon EID 1: PowerShell process created</description>
    <group>powershell,windows</group>
  </rule>

  <rule id="100011" level="12">
    <if_sid>100010</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-enc|-EncodedCommand|-e\s+[A-Za-z0-9+/]{20})</field>
    <description>ALERT: PowerShell encoded command execution detected [T1059.001]</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>powershell,obfuscation,high_severity</group>
  </rule>

  <rule id="100012" level="12">
    <if_sid>100010</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-bypass|-nop|-noni|-windowstyle\s+hidden|IEX|Invoke-Expression|DownloadString|WebClient)</field>
    <description>ALERT: Suspicious PowerShell flags — Bypass/Download cradle [T1059.001]</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>powershell,download_cradle,high_severity</group>
  </rule>

  <rule id="100020" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^13$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)(CurrentVersion\\Run|CurrentVersion\\RunOnce|Winlogon\\Shell|Winlogon\\Userinit)</field>
    <description>ALERT: Registry Run Key modified — persistence mechanism detected [T1547.001]</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>persistence,registry,high_severity</group>
  </rule>

  <rule id="100021" level="13">
    <if_sid>100020</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)(cmd\.exe|powershell\.exe|wscript\.exe|cscript\.exe|mshta\.exe|regsvr32\.exe|reg\.exe)</field>
    <description>CRITICAL: Registry Run Key set by scripting engine — likely malware persistence [T1547.001]</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>persistence,registry,critical</group>
  </rule>

  <rule id="100030" level="8">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4698$</field>
    <description>Windows EID 4698: Scheduled Task created</description>
    <group>scheduled_task,windows</group>
  </rule>

  <rule id="100031" level="12">
    <if_sid>100030</if_sid>
    <field name="win.eventdata.taskContent" type="pcre2">(?i)(cmd\.exe|powershell\.exe|wscript|cscript|mshta|regsvr32|rundll32|certutil)</field>
    <description>ALERT: Scheduled Task with shell/script payload — persistence or execution [T1053.005]</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>scheduled_task,persistence,high_severity</group>
  </rule>

  <rule id="100032" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.image" type="pcre2">(?i)schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create.*(cmd\.exe|powershell\.exe|calc\.exe|wscript|cscript|mshta)</field>
    <description>ALERT: Scheduled Task created with shell/script payload via schtasks [T1053.005]</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>scheduled_task,persistence,high_severity</group>
  </rule>


  <rule id="100040" level="8">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4720$</field>
    <description>Windows EID 4720: New local user account created [T1136.001]</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>account_creation,windows</group>
  </rule>

  <rule id="100041" level="13">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4732$</field>
    <field name="win.eventdata.groupName" type="pcre2">(?i)(Administrators|Administrateurs)</field>
    <description>ALERT: User added to local Administrators group [T1136.001]</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>account_creation,privilege_escalation,high_severity</group>
  </rule>


  <rule id="100050" level="5">
    <if_sid>60122</if_sid>
    <field name="win.system.eventID">^4625$</field>
    <description>Windows EID 4625: Authentication failure (single event)</description>
    <group>authentication_failure,windows</group>
  </rule>

  <rule id="100051" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100050</if_matched_sid>
    <same_field>agent.id</same_field>
    <description>ALERT: Brute Force — 5+ failed logins in 60s from same source [T1110.001]</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>brute_force,high_severity</group>
  </rule>


  <rule id="100053" level="15" frequency="100" timeframe="300">
    <if_matched_sid>100050</if_matched_sid>
    <same_field>agent.id</same_field>
    <description>CRITICAL: Sustained brute force — 100+ attempts in 5 min [T1110.001]</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>brute_force,critical</group>
  </rule>


  <rule id="100060" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(psexec|psexesvc|paexec|remcom)\.exe$</field>
    <description>ALERT: PsExec / remote admin tool executed — lateral movement indicator [T1021.002]</description>
    <mitre>
      <id>T1021.002</id>
    </mitre>
    <group>lateral_movement,high_severity</group>
  </rule>

  <rule id="100061" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^5140$</field>
    <field name="win.eventdata.shareName" type="pcre2">(?i)(\\\\ADMIN\$|\\\\C\$|\\\\IPC\$)</field>
    <description>ALERT: Administrative share accessed (ADMIN$/C$) — potential lateral movement [T1021.002]</description>
    <mitre>
      <id>T1021.002</id>
    </mitre>
    <group>lateral_movement,smb</group>
  </rule>

  <!-- Base: any CreateRemoteThread event -->
  <rule id="100070" level="8">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^8$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <description>Sysmon EID 8: CreateRemoteThread detected — possible process injection [T1055]</description>
    <mitre>
      <id>T1055</id>
    </mitre>
    <group>process_injection,windows</group>
  </rule>

  <rule id="100071" level="14">
    <if_sid>100070</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)(svchost\.exe|lsass\.exe|explorer\.exe|winlogon\.exe|csrss\.exe|spoolsv\.exe)</field>
    <description>CRITICAL: Remote thread injected into system process [T1055.001]</description>
    <mitre>
      <id>T1055.001</id>
    </mitre>
    <group>process_injection,critical</group>
  </rule>

  <rule id="100072" level="12">
    <if_sid>100010</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(DLL.?(Inject|Load|Side|System)|Get-System|Invoke-(DllInjection|ReflectivePEInjection|Shellcode)|VirtualAllocEx|WriteProcessMemory|CreateRemoteThread|UsoClient)</field>
    <description>ALERT: PowerShell-based DLL injection/side-loading technique [T1055.001]</description>
    <mitre>
      <id>T1055.001</id>
    </mitre>
    <group>process_injection,dll_sideloading,high_severity</group>
  </rule>

  <rule id="100073" level="13">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^11$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(powershell\.exe|cmd\.exe|wscript\.exe|cscript\.exe|mshta\.exe)</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)(\\System32\\|\\SysWOW64\\).*\.dll$</field>
    <description>CRITICAL: DLL dropped in system directory by scripting engine — DLL side-loading staging [T1055.001]</description>
    <mitre>
      <id>T1055.001</id>
    </mitre>
    <group>process_injection,dll_sideloading,critical</group>
  </rule>


  <rule id="100080" level="14">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1102$</field>
    <description>CRITICAL: Windows Security Audit Log cleared — active defense evasion [T1070.001]</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
    <group>defense_evasion,log_clearing,critical</group>
  </rule>

  <rule id="100081" level="14">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^104$</field>
    <description>CRITICAL: Windows System Event Log cleared (wevtutil/PowerShell) [T1070.001]</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
    <group>defense_evasion,log_clearing,critical</group>
  </rule>

  <rule id="100082" level="13">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(wevtutil\s+cl|Clear-EventLog|Remove-EventLog)</field>
    <description>ALERT: Event log clearing command executed [T1070.004]</description>
    <mitre>
      <id>T1070.004</id>
    </mitre>
    <group>defense_evasion,log_clearing,high_severity</group>
  </rule>


  <rule id="100090" level="11">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.image" type="pcre2">(?i)rundll32\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(javascript:|shell32\.dll,ShellExec|url\.dll,FileProtocolHandler|pcwutl\.dll|advpack\.dll|ieadvpack\.dll|http[s]?://)</field>
    <description>ALERT: Rundll32 abused with suspicious argument — LOLBas technique [T1218.011]</description>
    <mitre>
      <id>T1218.011</id>
    </mitre>
    <group>defense_evasion,lolbas,high_severity</group>
  </rule>

  <rule id="100091" level="13">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)rundll32\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(cmd\.exe|powershell\.exe|wscript\.exe|cscript\.exe)</field>
    <description>CRITICAL: Shell process spawned by rundll32 — code execution via LOLBas [T1218.011]</description>
    <mitre>
      <id>T1218.011</id>
    </mitre>
    <group>defense_evasion,lolbas,critical</group>
  </rule>

  <rule id="100100" level="11">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(certutil.*-urlcache|certutil.*-split|bitsadmin.*\/transfer|Invoke-WebRequest|Start-BitsTransfer|wget\s+http|curl.*-o.*http)</field>
    <description>ALERT: File download via LOLBin (certutil/bitsadmin) — tool transfer [T1105]</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>command_and_control,tool_transfer,high_severity</group>
  </rule>

  <rule id="100101" level="13">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^11$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)(\\Temp\\|\\AppData\\|\\ProgramData\\).+\.(exe|dll|ps1|bat|vbs|hta)</field>
    <description>CRITICAL: Executable created in suspicious directory — possible tool staging [T1105]</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>command_and_control,tool_transfer,critical</group>
  </rule>

  <rule id="100110" level="3">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.image" type="pcre2">(?i)(whoami|ipconfig|net\.exe|netstat|systeminfo|hostname|nltest|arp|route|tasklist|quser|cmdkey|reg\.exe)$</field>
    <description>Recon: System discovery command executed</description>
    <group>discovery,windows</group>
  </rule>

  <rule id="100111" level="11" frequency="5" timeframe="60">
    <if_matched_sid>100110</if_matched_sid>
    <same_field>agent.id</same_field>
    <description>ALERT: Rapid system discovery — 5+ recon commands in 60s [T1082]</description>
    <mitre>
      <id>T1082</id>
    </mitre>
    <group>discovery,reconnaissance,high_severity</group>
  </rule>

  <rule id="100112" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(net\s+(user|localgroup|group|accounts)|dsquery|ldifde|Get-ADUser|Get-ADGroup)</field>
    <description>ALERT: Account/Group enumeration command detected [T1087]</description>
    <mitre>
      <id>T1087</id>
    </mitre>
    <group>discovery,account_enumeration</group>
  </rule>

  <rule id="100113" level="8">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.image" type="pcre2">(?i)systeminfo\.exe$</field>
    <description>ALERT: systeminfo.exe executed — system information discovery [T1082]</description>
    <mitre>
      <id>T1082</id>
    </mitre>
    <group>discovery,reconnaissance,high_severity</group>
  </rule>
  <rule id="100114" level="8">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.image" type="pcre2">(?i)reg\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)query.*(HKLM|HKEY_LOCAL_MACHINE)\\SYSTEM</field>
    <description>ALERT: Registry query for system hardware/service info — recon [T1082]</description>
    <mitre>
      <id>T1082</id>
    </mitre>
    <group>discovery,reconnaissance,high_severity</group>
  </rule>

  <rule id="100120" level="11">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(certutil.*-decode|certutil.*-encode|certutil.*-decodehex)</field>
    <description>ALERT: Certutil decode/encode — payload deobfuscation [T1027]</description>
    <mitre>
      <id>T1027</id>
    </mitre>
    <group>defense_evasion,obfuscation,high_severity</group>
  </rule>

  <rule id="100121" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.channel">Microsoft-Windows-Sysmon/Operational</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(FromBase64String|ToBase64String|IO\.Compression|DeflateStream|GZipStream)</field>
    <description>ALERT: PowerShell deobfuscation/decompression detected [T1027]</description>
    <mitre>
      <id>T1027</id>
    </mitre>
    <group>defense_evasion,obfuscation,high_severity</group>
  </rule>
  
  <rule id="100122" level="12">
    <if_sid>100010</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-EncodedCommand\s+[A-Za-z0-9+/=]{20}|-enc\s+[A-Za-z0-9+/=]{20})</field>
    <description>ALERT: PowerShell base64-encoded command execution — obfuscation technique [T1027]</description>
    <mitre>
      <id>T1027</id>
    </mitre>
    <group>defense_evasion,obfuscation,high_severity</group>
  </rule>

</group>
